* {
  padding: 0;
  margin: 0;
}
body,
html {
  height: 100vh;
  background-color: #fff;
  margin: 0;
  overflow: hidden;
  user-select: text;
}
.contentWrap {
  box-sizing: border-box;
  height: 100%;
  position: relative;
  z-index: 1;
}
.refreshWrap {
  height: calc(100vh - 80px);
  overflow: scroll;
  -webkit-overflow-scrolling: touch;
  /* 为iOS添加回弹效果 */
}
.middleArea {
  height: 100px;
  color: gray;
  font-size: 20px;
  border: 1px solid #000;
}
.homeHeader {
  height: 80px;
  background-color: lightblue;
  color: gray;
  font-size: 20px;
  display: flex;
  align-items: center;
  justify-content: center;
}
.pullDownContent {
  display: flex;
  align-items: flex-end;
  justify-content: center;
  font-size: 12px;
  color: rgba(0, 0, 0, 0.25);
  margin: auto;
  transition: height 0.3s ease-out;
  /* 平滑过渡效果 */
  overflow: hidden;
}
.loadingFlex {
  display: flex;
  align-items: flex-end;
  justify-content: center;
  padding: 10px 0;
  transition: all 0.3s;
}
.loadingFlex .loadingRing {
  width: 14px;
  height: 14px;
  border: 2.5px rgba(0, 0, 0, 0.07) solid;
  border-top: 2.5px rgba(0, 0, 0, 0.2) solid;
  border-radius: 50%;
  animation: spin 0.6s infinite linear;
}
@keyframes spin {
  to {
    transform: rotate(360deg);
  }
}
.loadingFlex .loadingText {
  text-align: center;
  font-size: 12px;
  margin-left: 5px;
  color: rgba(0, 0, 0, 0.25);
}
.loadingFlex .flexCenter {
  display: flex;
  justify-content: center;
  align-items: center;
}
.loadingHidden {
  height: 0;
  padding: 0;
  opacity: 0;
  overflow: hidden;
  transition: all 0.3s;
}
/* 为Vue版本添加的过渡样式 */
.fade-enter-active,
.fade-leave-active {
  transition: opacity 0.5s;
}
.fade-enter-from,
.fade-leave-to {
  opacity: 0;
}
/* 聊天记录相关样式，配合Vue 3组件使用 */
.chat-content {
  padding: 10px;
  overflow-y: auto;
  height: 100%;
}
.chat-item {
  margin-bottom: 16px;
}
.chat-question {
  display: flex;
  justify-content: flex-end;
  margin-bottom: 8px;
}
.question-content {
  background-color: #e1f3ff;
  padding: 12px;
  border-radius: 8px;
  max-width: 80%;
  word-break: break-word;
}
.chat-answer {
  display: flex;
  justify-content: flex-start;
  margin-bottom: 4px;
}
.answer-content {
  background-color: #f5f5f5;
  padding: 12px;
  border-radius: 8px;
  max-width: 80%;
  word-break: break-word;
}
.answer-loading {
  background-color: #f5f5f5;
  padding: 12px;
  border-radius: 8px;
  display: flex;
  align-items: center;
}
.chat-time {
  font-size: 12px;
  color: #999;
  text-align: center;
  margin: 4px 0;
}
